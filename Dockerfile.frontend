FROM node:22-alpine AS build

WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/frontend/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 80;\n  location /api/ { proxy_pass http://backend:8000/api/; proxy_set_header Host $host; proxy_buffering off; }\n  location /mock-cpgrams/ { proxy_pass http://backend:8000/mock-cpgrams/; proxy_set_header Host $host; }\n  location / { root /usr/share/nginx/html; try_files $uri $uri/ /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
