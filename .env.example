# ==============================================================================
# JanSahayak AI — IIT KGP Track B Capstone Environment Configuration
# Copy this file to `.env` and fill in the MANDATORY values before running.
# NEVER commit `.env` or `certs/` to Git!
# ==============================================================================

# --- [MANDATORY] Track B Hosted Inference API (Qwen/Qwen3-8B) ---
# Match your Group ID from Track_B_Inference_API_Learner_Guide.docx.pdf:
#   001-015 -> https://103.42.50.41:1031/v1 (certs/vm07-ca.crt)
#   016-030 -> https://103.42.50.41:1032/v1 (certs/vm06-ca.crt)
#   031-045 -> https://103.42.50.41:1033/v1 (certs/vm05-ca.crt)
#   046-065 -> https://103.42.50.41:1034/v1 (certs/vm04-ca.crt)
LLM_BASE_URL=https://103.42.50.41:1034/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=REPLACE_WITH_YOUR_GROUP_API_KEY
LLM_CA_CERT_PATH=certs/vm04-ca.crt
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_MAX_RPM=55
LLM_MAX_OUTPUT_TOKENS=1024

# --- [MANDATORY] Track B Hosted Embeddings API (bge-small-en-v1.5) ---
# Copy key from: Capstone_Overview_resources/API/VM02_Embeddings_Access/shared-embedding-key.txt
EMBEDDING_BASE_URL=https://103.42.50.41:1035/v1
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_API_KEY=REPLACE_WITH_SHARED_EMBEDDING_KEY
EMBEDDING_CA_CERT_PATH=Capstone_Overview_resources/API/VM02_Embeddings_Access/vm02-ca.crt
EMBEDDING_BATCH_SIZE=16

# --- Corpus & Retrieval Settings ---
INGEST_SCOPE=central
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
WEB_FALLBACK_THRESHOLD=0.25
SEMANTIC_CACHE_THRESHOLD=0.96
RATE_LIMIT_RPM_PER_SESSION=15
# Evaluation switches (leave as-is for the live chatbot):
# true = FAQ chunks are never retrieved, so the gold Q&A set cannot be answered from the FAQs
RETRIEVAL_EXCLUDE_FAQ_CHUNKS=false
# Uncomment to make every search return exactly k chunks (1-8) for the top-1/3/5 experiments
# RETRIEVAL_TOP_K_OVERRIDE=3

# --- Google Gemini (evals only: second LLM + LLM-as-judge) ---
# Free key: https://aistudio.google.com -> Get API key. Leave empty to skip the Gemini runs and the judge.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_EFFORT=low
# Free tier: keep this low
GEMINI_MAX_RPM=5

# --- Agent Loop Safety Limits (Track B section IV) ---
# false = single-pass pipeline (ablation baseline for the with/without-loop comparison)
AGENT_REFLECTION_ENABLED=true
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_REFLECTION_ROUNDS=2
AGENT_TOKEN_BUDGET=24000

# --- Grievance Execution Mode ---
# Options: sandbox (default for Capstone demo + Assisted Handoff) | assisted | apisetu
GRIEVANCE_MODE=sandbox
MOCK_CPGRAMS_BASE_URL=http://127.0.0.1:8000/mock-cpgrams/v1

# --- Server & Storage ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=data/jansahayak.db
INDEX_DIR=data/index

# --- [OPTIONAL] Web Search Upgrade (Leave blank to use free DuckDuckGo .gov.in fallback) ---
TAVILY_API_KEY=

# --- [OPTIONAL] Production Multilingual Voice/NMT Upgrade (Leave blank for Qwen3 + Web Speech API) ---
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
SARVAM_API_KEY=

# --- [OPTIONAL] Production API Setu / CPGRAMS Credentials (Post-Capstone) ---
APISETU_CLIENT_ID=
APISETU_API_KEY=

# --- [OPTIONAL] SMTP Credentials for Real CPGRAMS Sandbox Confirmation Emails ---
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=your_app_password
# If left blank, emails are rendered & stored in the built-in Sandbox Email Outbox!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply-sandbox@jansahayak.local
SMTP_USE_TLS=true
